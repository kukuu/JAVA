{
  "name": "le-alert-correlation-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "security:scan": "npm audit && npx snyk test",
    "build:dev": "vite build --mode development",
    "build:staging": "vite build --mode staging",
    "build:prod": "vite build --mode production",
    "preview:prod": "vite preview --port 4173",
    "deploy:dev": "npm run build:dev && aws s3 sync dist/ s3://le-alerts-dev --delete",
    "deploy:staging": "npm run build:staging && aws s3 sync dist/ s3://le-alerts-staging --delete",
    "deploy:prod": "npm run build:prod && aws s3 sync dist/ s3://le-alerts-prod --delete",
    "docker:build": "docker build -t le-alerts-ui:latest .",
    "docker:run": "docker run -p 3000:80 le-alerts-ui:latest",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.2",
    "@tanstack/react-query": "^4.32.6",
    "@tanstack/react-query-devtools": "^4.32.6",
    "axios": "^1.5.0",
    "crypto-js": "^4.1.1",
    "date-fns": "^2.30.0",
    "leaflet": "^1.9.4",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.7.0",
    "chart.js": "^4.4.0",
    "react-chartjs-2": "^5.2.0",
    "zustand": "^4.4.1",
    "react-hook-form": "^7.45.4",
    "zod": "^3.22.4",
    "@hookform/resolvers": "^3.3.2",
    "clsx": "^2.0.0",
    "tailwindcss": "^3.3.3",
    "autoprefixer": "^10.4.15",
    "postcss": "^8.4.29",
    "@heroicons/react": "^2.0.18",
    "framer-motion": "^10.16.4",
    "react-hot-toast": "^2.4.1",
    "react-intersection-observer": "^9.5.3",
    "react-virtualized-auto-sizer": "^1.0.10",
    "react-window": "^1.8.10",
    "socket.io-client": "^4.6.1",
    "@stomp/stompjs": "^7.0.0",
    "qrcode.react": "^3.1.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "papaparse": "^5.4.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vite-plugin-pwa": "^0.16.4",
    "vitest": "^0.34.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/user-event": "^14.4.3",
    "playwright": "^1.37.1",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.5.1",
    "@storybook/react": "^7.4.0",
    "@storybook/react-vite": "^7.4.0",
    "@storybook/addon-essentials": "^7.4.0",
    "@storybook/addon-interactions": "^7.4.0",
    "@storybook/addon-links": "^7.4.0",
    "@storybook/addon-onboarding": "^1.0.8",
    "@storybook/blocks": "^7.4.0",
    "@storybook/test": "^7.4.0"
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all", "not ie > 0", "not safari < 12"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  }
}